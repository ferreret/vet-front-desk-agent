# Copy to .env (never committed).

# Needed to talk to the agent (`vetdesk chat`): by default it runs on Gemini. Not needed
# for the generator, the identity resolver or the tests.
GEMINI_API_KEY=

# Only for the judge of the evaluation (`vetdesk eval run` without `--no-judge`), which is
# a Claude model. The simulated callers run on Gemini.
# ANTHROPIC_API_KEY=

# Only if that key is not tied to a workspace (the API says so in a 400 error).
# ANTHROPIC_WORKSPACE_ID=

# Only to use OpenAI models (`--model gpt-6-luna`).
# OPENAI_API_KEY=

# Only to use models through the Requesty router (`--model zai/glm-5.3-flash`).
# REQUESTY_API_KEY=

# Optional. Defaults: gemini, gemini-3.5-flash-lite.
# A model id that names its provider (claude-..., gemini-..., gpt-..., or the router's
# served-by/model form) needs no provider.
# VETDESK_LLM_PROVIDER=gemini
# VETDESK_LLM_MODEL=gemini-3.5-flash-lite
# Claude models only. Defaults: low effort, thinking off.
# VETDESK_LLM_EFFORT=low
# VETDESK_LLM_THINKING=off

# Voice (`uv run python -m vetdesk.voice console`): ElevenLabs hears and speaks.
# ELEVEN_API_KEY=
# Optional. Defaults: eleven_v4_turbo, ElevenLabs' default voice, scribe_v2_realtime.
# VETDESK_TTS_MODEL=eleven_v4_turbo
# VETDESK_TTS_VOICE=
# VETDESK_STT_MODEL=scribe_v2_realtime
# Languages callers may speak; the first is the clinic's own. A long list makes the
# recogniser mistake Spanish for another language.
# VETDESK_STT_LANGUAGES=es,ca
# Seconds of silence that close what the caller said.
# VETDESK_STT_PAUSE=0.6
# Optional: pretend the call comes from this number (a microphone has no caller ID).
# VETDESK_CALLER_NUMBER=+34618065507
# Optional, on the voice server and when setting the platform's agent up: the phone a
# person answers at. A caller who wants a person is put through to it while the clinic
# is open; without it, or out of hours, a message is taken.
# VETDESK_TRANSFER_TO=
# Optional, on the voice server only: tell reception what happens on each call (a message
# taken, an emergency, an appointment booked, moved or cancelled) in a Telegram chat.
# The key of a bot made with @BotFather, and the id of the chat it posts to.
# VETDESK_TELEGRAM_TOKEN=
# VETDESK_TELEGRAM_CHAT=
# Optional, on the voice server only: keep the clinic's information in a file on the
# server's disk, so that it can be changed without a deployment, and the key that lets
# it be read and replaced at /clinic and edited at /clinic/edit.
# VETDESK_CLINIC=/app/state/clinic.toml
# VETDESK_ADMIN_KEY=
# Optional, on the voice server only: the file the appointment book is kept in, so that a
# restart does not empty it. In a container it must be on a mounted volume.
# VETDESK_AGENDA=/app/state/agenda.db
# Optional, on the voice server only: write every call down (what was said, what was done,
# what the model cost) in a file of its own, read back with VETDESK_ADMIN_KEY at /calls
# and looked at in /calls/view. Calls older than the days given are dropped.
# VETDESK_CALLS=/app/state/calls.db
# VETDESK_CALLS_KEEP_DAYS=90
# Optional, on your own machine: where the voice server is, for `vetdesk costs` to read
# its call log. Never written in this repository.
# VETDESK_SERVER=
# Optional, on the voice server only: show the appointments in a Google Calendar too. The
# calendar's id and the JSON key of a service account the calendar is shared with, as it
# is or in base64.
# VETDESK_GOOGLE_CALENDAR=
# VETDESK_GOOGLE_KEY=
# Optional, on the voice server only: real phones that call as a number of the made-up
# clinic, to try the usual call (from the number on one's record). The clinic's records
# stay invented, and a real number is never written anywhere in this repository.
# VETDESK_CALLER_STANDS_IN_FOR=<your phone>=<a phone on a client's record>
