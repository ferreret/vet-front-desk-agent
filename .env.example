# Copy to .env (never committed).

# Needed to talk to the agent (`vetdesk chat`). Not needed for the generator, the
# identity resolver or the tests.
ANTHROPIC_API_KEY=

# Only if the key is not tied to a workspace (the API says so in a 400 error).
# ANTHROPIC_WORKSPACE_ID=

# Only to use Gemini models (`--model gemini-flash-latest`).
# GEMINI_API_KEY=

# Only to use OpenAI models (`--model gpt-6-luna`).
# OPENAI_API_KEY=

# Only to use models through the Requesty router (`--model zai/glm-5.3-flash`).
# REQUESTY_API_KEY=

# Optional. Defaults: anthropic, claude-sonnet-5-5, low effort, thinking off.
# A model id that names its provider (claude-..., gemini-..., gpt-..., or the router's
# served-by/model form) needs no provider.
# VETDESK_LLM_PROVIDER=anthropic
# VETDESK_LLM_MODEL=claude-sonnet-5-5
# VETDESK_LLM_EFFORT=low
# VETDESK_LLM_THINKING=off

# Voice (`uv run python -m vetdesk.voice console`): ElevenLabs hears and speaks.
# ELEVEN_API_KEY=
# Optional. Defaults: eleven_v4_turbo, ElevenLabs' default voice, scribe_v2_realtime.
# VETDESK_TTS_MODEL=eleven_v4_turbo
# VETDESK_TTS_VOICE=
# VETDESK_STT_MODEL=scribe_v2_realtime
# Languages callers may speak; the first is the clinic's own. A long list makes the
# recogniser mistake Spanish for another language.
# VETDESK_STT_LANGUAGES=es,ca
# Seconds of silence that close what the caller said.
# VETDESK_STT_PAUSE=0.6
# Optional: pretend the call comes from this number (a microphone has no caller ID).
# VETDESK_CALLER_NUMBER=+34618065507
